using System.Security.Cryptography.X509Certificates;

namespace Backend
{
    public class ListaDoble<T> where T : IComparable<T>
    {
        private Nodo<T> cabeza;
        private Nodo<T> cola;
        public bool EstaVacia()
        {
            return cabeza == null;
        }
        //1.ADD
        //Insert directly in ascending order.
        public void Adicionar(T dato)
        {
            Nodo<T> nuevo = new Nodo<T>(dato);
            if (cabeza == null)
            {
                cabeza = nuevo;
                cola = nuevo;
                return;
            }
            if (dato.CompareTo(cabeza.Dato) <= 0)
            {
                nuevo.Siguiente = cabeza;
                cabeza.Anterior = nuevo;
                cabeza = nuevo;
                return;
            }
            if (cola != null && dato.CompareTo(cola.Dato) >= 0)
            {
                nuevo.Anterior = cola;
                cola.Siguiente = nuevo;
                cola = nuevo;
                return;
            }

            Nodo<T> actual = cabeza;
            while (actual.Siguiente != null && actual.Siguiente.Dato.CompareTo(dato) < 0)
            {
                actual = actual.Siguiente;
            }
            nuevo.Siguiente = actual.Siguiente;
            nuevo.Anterior = actual;
            if (actual.Siguiente != null)
            {
                actual.Siguiente.Anterior = nuevo;
            }
            actual.Siguiente = nuevo;
        }
        // 2. SHOW FORWARD
        public void MostrarAdelante()
        {
            if (cabeza == null)
            {
                Console.WriteLine("\nla lista está vacía.");
                return;
            }
            Nodo<T> actual = cabeza;
            Console.WriteLine("\n Lista hacia adelante:");
            while (actual != null)
            {
                Console.WriteLine(actual.Dato);
                if (actual.Siguiente != null)
                {
                    Console.Write(" <-> ");
                }
                actual = actual.Siguiente;
            }
            Console.WriteLine();

        }

        // 3. SHOW BACKWARD
        public void MostrarAtras()
        {
            if (cola == null)
            {

                Console.WriteLine("\nla lista está vacía.");
                return;
            }
            Nodo<T> actual = cola;
            Console.WriteLine("\n Lista hacia atrás:");
            while (actual != null)
            {
                Console.WriteLine(actual.Dato);
                if (actual.Anterior != null)
                {
                    Console.Write(" <-> ");
                }
                actual = actual.Anterior;
            }
            Console.WriteLine();
        }
        //// 4. SORT IN DESCENDING ORDER
        public void OrdenarDescendente()
        {
            if (cabeza == null || cabeza.Siguiente == null)
            {
                return;
            }
            Nodo<T> actual = cabeza;
            while (actual != null)
            {
                Nodo<T> siguiente = actual.Siguiente;
                while (siguiente != null)
                {
                    if (actual.Dato.CompareTo(siguiente.Dato) < 0)
                    {
                        // Swap the data of the nodes
                        T temp = actual.Dato;
                        actual.Dato = siguiente.Dato;
                        siguiente.Dato = temp;
                    }
                    siguiente = siguiente.Siguiente;
                }
                actual = actual.Siguiente;
            }
        }

        // 5. DISPLAY THE MODES
        public void MostrarModas()
        {
            if (cabeza == null)
            {
                Console.WriteLine("\nla lista está vacía.");
                return;
            }
            Dictionary<T, int> frecuencia = new Dictionary<T, int>();
            Nodo<T>? actual = cabeza;
            while (actual != null)
            {
                if (frecuencia.ContainsKey(actual.Dato))
                {
                    frecuencia[actual.Dato]++;
                }
                else
                {
                    frecuencia.Add(actual.Dato, 1);
                }
                actual = actual.Siguiente;
            }
            int mayorFrecuencia = 0;
            foreach (var elemento in frecuencia)
            {
                if (elemento.Value > mayorFrecuencia)
                {
                    mayorFrecuencia = elemento.Value;
                }
            }

            Console.WriteLine("\n la(s) Moda(s) son :");
            bool primera = true;
            foreach (var elemento in frecuencia)
            {
                if (elemento.Value == mayorFrecuencia)
                {
                    if (!primera)
                    {
                        Console.Write(", ");
                    }
                    Console.Write(elemento.Key);
                    primera = false;
                }
            }
            Console.WriteLine($"(aparece(n) {mayorFrecuencia} vez/veces)");
        }
        //6. DISPLAY GRAPH
        public void MostrarGrafico()
        {
            if (cabeza == null)
            {
                Console.WriteLine("\nla lista está vacía.");
                return;
            }
            Dictionary<T, int> frecuencia = new Dictionary<T, int>();
            Nodo<T>? actual = cabeza;
            while (actual != null)
            {
                if (frecuencia.ContainsKey(actual.Dato))
                {
                    frecuencia[actual.Dato]++;
                }
                else
                {
                    frecuencia.Add(actual.Dato, 1);
                }
                actual = actual.Siguiente;
            }
            Console.WriteLine("\n===== GRÁFICO =====");
            foreach (var elemento in frecuencia)
            {
                Console.Write($"{elemento.Key} ");
                for (int i = 0; i < elemento.Value; i++)
                {
                    Console.Write("*");
                }
                Console.WriteLine();
            }
        }

        // 7. EXISTS
        public bool Existe(T dato)
        {
            Nodo<T> actual = cabeza;
            while (actual != null)
            {
                if (actual.Dato.CompareTo(dato) == 0)
                {
                    return true;
                }
                actual = actual.Siguiente;
            }
            return false;
        }
        // 8. REMOVE AN OCCURRENCE
        public bool EliminarUna(T dato)
        {
            Nodo<T> actual = cabeza;
            while (actual != null)
            {
                if (actual.Dato.CompareTo(dato) == 0)
                {
                    if (actual == cabeza)
                    {
                        EliminarNodo(actual);
                        return true;
                    }
                    actual = actual.Siguiente;
                }
                return false;
            }
            

            // 9. REMOVE ALL OCCURRENCES
            public int EliminarTodas(T dato)
        {
            int cantidadEliminada = 0;

            Nodo<T>? actual = cabeza;

            while (actual != null)
            {
                Nodo<T>? siguiente = actual.Siguiente;

                if (actual.Dato.CompareTo(dato) == 0)
                {
                    EliminarNodo(actual);
                    cantidadEliminada++;
                }

                actual = siguiente;
            }

            return cantidadEliminada;
        }

        private void EliminarNodo(Nodo<T> nodo)
        {
            if (nodo.Anterior != null)
            {
                nodo.Anterior.Siguiente = nodo.Siguiente;
            }
            else
            {
                cabeza = nodo.Siguiente;
            }

            if (nodo.Siguiente != null)
            {
                nodo.Siguiente.Anterior = nodo.Anterior;
            }
            else
            {
                cola = nodo.Anterior;
            }

            nodo.Anterior = null;
            nodo.Siguiente = null;
        }
    }
}




